*.token
*token*.txt
*password*
*notary*
*.pem
*.key
*.p12
# Apple code-signing material. The private key and the Apple ID live outside
# this repo (~/.socialmcp-signing/), sourced as env vars at build time; these
# patterns are the second line of defence if one is ever copied in here.
*.csr
*.cer
*.certSigningRequest
*.provisionprofile
*.mobileprovision
signing.env
secrets.*
.secrets/
.netrc
.git-credentials
gh-token*
github-token*
*_credentials.json
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Personal data — the whole point of this project is that it never leaves the
# machine. Exports, the SQLite CRM, and the drop folder stay local.
# ---------------------------------------------------------------------------
# The drop-zone folder structure is committed (.gitkeep); its contents are not.
drop-archive/**/*.zip
drop-archive/**/*.csv
drop-archive/**/*.json
drop-archive/**/README.md
ingested
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
Connections.csv
Invitations.csv
messages.csv
Profile.csv
Basic_LinkedInDataExport*.zip
*LinkedInDataExport*.zip
!tests/fixtures/**/*.csv

# Local config may contain API keys / absolute paths
socialmcp.toml
!socialmcp.example.toml

# Private planning documents — business strategy, monetization, roadmap.
# Kept on disk for your own reference, never published.
ROADMAP.md
NOTES.md
PLANNING.md
PRIVATE.md
/private/
/notes/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/

# Build artifacts. Installers are published as GitHub Releases, never
# committed: binaries bloat history permanently, and a release asset gives
# version tags, changelogs and download counts for free. The build scripts
# themselves ARE committed, so anyone can reproduce the installer from source
# and verify it matches — which matters for a tool that reads private data.
# No trailing slashes, for the same reason as the venv rules below: git cannot
# tell that a path which does not exist yet is a directory, so a dir-only
# pattern silently fails to match in a fresh clone — which is where it matters.
build
dist
*.dmg
*.pkg
*.app
.venv
.venv-*
venv
venv-*
*.venv
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
